/* 地图卡片 - 电竞暗黑风格 */
.route-list {
  display: flex;
  flex-direction: column;
  max-height: 400px;
  background: linear-gradient(135deg, rgba(20, 20, 40, 0.9), rgba(28, 28, 56, 0.8));
  padding: 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(42, 42, 74, 0.6);
  backdrop-filter: blur(10rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.route-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid rgba(42, 42, 74, 0.5);
  margin-bottom: 16rpx;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
  color: var(--primary-gold);
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon:active {
  transform: scale(0.9);
}

.route-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--primary-gold);
  text-shadow: 0 0 20rpx rgba(255, 215, 0, 0.4);
}

.route-content {
  flex: 1;
  overflow-y: auto;
  padding: 8rpx 0;
}

.route-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 2rpx solid rgba(42, 42, 74, 0.4);
  transition: all 0.2s ease;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  background: rgba(0, 0, 0, 0.2);
  padding-left: 16rpx;
  padding-right: 16rpx;
}

.route-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.route-item:active {
  background: rgba(230, 48, 40, 0.2);
  transform: translateX(8rpx);
}

.icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
  color: white;
  font-weight: bold;
}

.start .icon {
  background: linear-gradient(135deg, #10b981, #059669);
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.4);
}

.end .icon {
  background: linear-gradient(135deg, var(--primary-red), #c41e12);
  box-shadow: 0 4rpx 12rpx rgba(230, 48, 40, 0.4);
}

.details {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.instruction {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  line-height: 1.5;
}

.direction {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.direction::before {
  content: '📍';
  font-size: 20rpx;
}