.home-page {
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
  background: #020813;
  color: #f7e7c4;
}

.cosmos-bg {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 50% 12%, rgba(0, 88, 190, 0.26), transparent 34%),
    radial-gradient(ellipse at 8% 45%, rgba(0, 77, 183, 0.15), transparent 33%),
    radial-gradient(ellipse at 94% 64%, rgba(0, 98, 170, 0.12), transparent 30%),
    linear-gradient(180deg, #020711 0%, #030b18 54%, #01050d 100%);
}

.cosmos-bg::before {
  content: '';
  position: absolute;
  inset: 0;
  opacity: 0.62;
  background-image:
    radial-gradient(circle, rgba(255, 225, 148, 0.75) 0, rgba(255, 225, 148, 0.75) 1rpx, transparent 2rpx),
    radial-gradient(circle, rgba(31, 147, 255, 0.82) 0, rgba(31, 147, 255, 0.82) 1rpx, transparent 3rpx);
  background-position: 18rpx 42rpx, 74rpx 18rpx;
  background-size: 113rpx 127rpx, 157rpx 139rpx;
}

.cosmos-bg::after {
  content: '';
  position: absolute;
  left: -18%;
  right: -18%;
  top: 150rpx;
  height: 260rpx;
  opacity: 0.38;
  background: linear-gradient(112deg, transparent 12%, rgba(0, 97, 217, 0.12) 28%, rgba(44, 145, 255, 0.42) 30%, transparent 31%, transparent 48%, rgba(0, 104, 228, 0.27) 49%, transparent 52%, transparent 68%, rgba(255, 193, 75, 0.18) 69%, transparent 71%);
  transform: rotate(-7deg);
  filter: blur(5rpx);
}

.nebula { position: absolute; border-radius: 50%; filter: blur(70rpx); opacity: 0.22; }
.nebula-left { width: 400rpx; height: 300rpx; left: -230rpx; top: 300rpx; background: #006cfa; }
.nebula-right { width: 360rpx; height: 320rpx; right: -240rpx; top: 740rpx; background: #00a7e4; }
.particle-layer { position: absolute; inset: 0; opacity: 0.58; }
.particle { position: absolute; border-radius: 50%; animation: starFloat 7s ease-in-out infinite; }

.content-wrapper {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 100vh;
  padding-top: calc(44rpx + 20px);
  padding-bottom: 40rpx;
  box-sizing: border-box;
  opacity: 0;
  transform: translateY(26rpx);
  transition: opacity 0.55s ease, transform 0.55s ease;
}
.content-wrapper.visible { opacity: 1; transform: translateY(0); }
.animate-on-visible { opacity: 0; transform: translateY(22rpx); transition: opacity 0.45s ease, transform 0.45s ease; }
.content-wrapper.visible .animate-on-visible { opacity: 1; transform: translateY(0); }
.delay-1 { transition-delay: 0.05s; }
.delay-2 { transition-delay: 0.12s; }
.delay-3 { transition-delay: 0.2s; }
.delay-4 { transition-delay: 0.29s; }
.delay-5 { transition-delay: 0.38s; }

/* 自定义导航：为右侧微信胶囊保留空间 */
.custom-nav {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 84rpx;
  padding: calc(env(safe-area-inset-top) + 6rpx) 28rpx 8rpx;
  box-sizing: content-box;
}
.capsule-safe-space { width: 176rpx; height: 64rpx; margin-left: auto; }
.nav-title-image { position: absolute; left: 50%; bottom: -33rpx; width: 330rpx; height: 110rpx; transform: translateX(-50%); filter: drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, 0.75)); }

.hero-section {
  position: relative;
  height: 190rpx;
  margin-top: -4rpx;
  overflow: visible;
}
.hero-emblem {
  position: absolute;
  z-index: 2;
  left: 2rpx;
  top: -16rpx;
  width: 250rpx;
  height: 250rpx;
  filter: drop-shadow(0 0 20rpx rgba(0, 126, 255, 0.6));
}
.hero-title-image { position: absolute; z-index: 3; left: 208rpx; right: 4rpx; top: 17rpx; width: 530rpx; height: 176rpx; }
.hero-energy { position: absolute; z-index: 1; height: 2rpx; background: linear-gradient(90deg, transparent, #168dff, #fff, transparent); box-shadow: 0 0 12rpx #007cff; transform: rotate(-20deg); }
.energy-a { left: 80rpx; top: 40rpx; width: 290rpx; }
.energy-b { right: -30rpx; bottom: 34rpx; width: 240rpx; transform: rotate(-33deg); }

/* 深夜时光问答主卡 */
.ornate-panel {
  position: relative;
  margin: 20rpx 27rpx 0;
  overflow: hidden;
  border: 2rpx solid rgba(203, 150, 71, 0.85);
  border-radius: 7rpx 7rpx 18rpx 7rpx;
  background:
    linear-gradient(90deg, rgba(1, 14, 31, 0.2), rgba(4, 21, 45, 0.94)),
    radial-gradient(circle at 18% 48%, rgba(0, 87, 201, 0.3), transparent 40%),
    #041020;
  box-shadow: inset 0 0 0 5rpx rgba(1, 10, 24, 0.9), inset 0 0 45rpx rgba(0, 87, 179, 0.12), 0 12rpx 30rpx rgba(0, 0, 0, 0.45);
}
.night-card { display: flex; height: 360rpx; box-sizing: border-box; }
.night-card::before { content: ''; position: absolute; z-index: 1; left: 9rpx; right: 9rpx; top: 9rpx; bottom: 9rpx; border: 1rpx solid rgba(204, 151, 73, 0.3); pointer-events: none; }
.night-visual { position: relative; width: 43%; height: 100%; overflow: hidden; }
.night-visual::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent 58%, #04142b 100%); }
.night-visual image { position: absolute; left: -20rpx; top: 15rpx; width: 330rpx; height: 330rpx; filter: drop-shadow(0 0 18rpx rgba(0, 96, 234, 0.36)); }
.night-content { position: relative; z-index: 2; flex: 1; padding: 38rpx 22rpx 22rpx 4rpx; }
.welcome-title-image { display: block; width: 250rpx; height: 84rpx; margin: -15rpx 0 -4rpx 2rpx; filter: drop-shadow(0 3rpx 7rpx rgba(0, 0, 0, 0.8)); }
.welcome-message { margin-top: 5rpx; color: #d5cad0; font-size: 24rpx; letter-spacing: 1rpx; }
.welcome-suggestions { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx 14rpx; margin-top: 25rpx; }
.suggestion-tag {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 56rpx;
  padding: 0 7rpx;
  color: #e5c98f;
  font-size: 19rpx;
  letter-spacing: 0;
  background: linear-gradient(180deg, rgba(13, 35, 63, 0.94), rgba(5, 19, 39, 0.96));
  border: 1rpx solid rgba(196, 145, 71, 0.78);
  border-radius: 10rpx;
  box-shadow: inset 0 0 12rpx rgba(0, 104, 219, 0.08);
  box-sizing: border-box;
}
.suggestion-tag::before, .suggestion-tag::after { content: ''; position: absolute; top: 50%; width: 6rpx; height: 6rpx; background: #c49349; transform: translateY(-50%) rotate(45deg); }
.suggestion-tag::before { left: -4rpx; }
.suggestion-tag::after { right: -4rpx; }
.suggestion-tag text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.suggestion-tag:active { color: #fff2c9; border-color: #f1c46d; background: rgba(24, 56, 93, 0.96); transform: scale(0.97); }
.panel-corner { position: absolute; z-index: 5; width: 22rpx; height: 22rpx; border-color: #e3b35d; border-style: solid; pointer-events: none; }
.corner-tl { left: 4rpx; top: 4rpx; border-width: 3rpx 0 0 3rpx; }
.corner-tr { right: 4rpx; top: 4rpx; border-width: 3rpx 3rpx 0 0; }
.corner-bl { left: 4rpx; bottom: 4rpx; border-width: 0 0 3rpx 3rpx; }
.corner-br { right: 4rpx; bottom: 4rpx; border-width: 0 3rpx 3rpx 0; }

/* 三个功能入口 */
.core-entries { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; margin: 38rpx 27rpx 0; }
.entry-card {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 253rpx;
  padding: 9rpx 9rpx 6rpx;
  overflow: hidden;
  text-align: center;
  border: 2rpx solid rgba(121, 177, 225, 0.5);
  border-radius: 10rpx 10rpx 20rpx 10rpx;
  box-sizing: border-box;
  box-shadow: inset 0 0 0 4rpx rgba(1, 8, 19, 0.68), 0 10rpx 22rpx rgba(0, 0, 0, 0.32);
}
.entry-card::before { content: ''; position: absolute; z-index: 4; inset: 7rpx; border: 1rpx solid rgba(203, 157, 84, 0.28); pointer-events: none; }
.entry-card::after { content: ''; position: absolute; z-index: 1; inset: 0; background: linear-gradient(180deg, rgba(2, 10, 24, 0.06) 0%, rgba(2, 10, 24, 0.34) 47%, rgba(2, 9, 20, 0.88) 100%); pointer-events: none; }
.entry-bg { position: absolute; z-index: 0; inset: 0; width: 100%; height: 100%; }
.entry-chat { background: radial-gradient(circle at 50% 22%, rgba(0, 106, 243, 0.38), transparent 52%), linear-gradient(180deg, #061d3c, #031022); }
.entry-ar { border-color: rgba(151, 125, 231, 0.63); background: radial-gradient(circle at 50% 22%, rgba(105, 57, 237, 0.45), transparent 54%), linear-gradient(180deg, #17134c, #090d2e); }
.entry-route { border-color: rgba(79, 197, 189, 0.6); background: radial-gradient(circle at 50% 22%, rgba(0, 154, 164, 0.38), transparent 54%), linear-gradient(180deg, #062f3a, #03181e); }
.entry-icon-zone { position: relative; z-index: 2; display: flex; flex: 0 0 112rpx; align-items: center; justify-content: center; width: 100%; }
.feature-icon-crop { position: relative; width: 112rpx; height: 112rpx; overflow: hidden; }
.feature-sprite { position: absolute; top: 0; width: 336rpx; height: auto; }
.sprite-chat { left: 0; }
.sprite-ar { left: -112rpx; }
.sprite-route { left: -224rpx; }
.entry-copy { position: relative; z-index: 2; display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: flex-start; width: 100%; padding-top: 3rpx; box-sizing: border-box; }
.entry-title { position: relative; z-index: 2; color: #f1d49a; font-family: STSong, "Songti SC", SimSun, serif; font-size: 27rpx; font-weight: 900; line-height: 1.25; letter-spacing: 1rpx; text-shadow: 0 2rpx 4rpx #000; white-space: nowrap; }
.entry-desc { position: relative; z-index: 2; color: #c6c6d2; font-family: STSong, "Songti SC", SimSun, serif; font-size: 19rpx; font-weight: 400; line-height: 1.35; letter-spacing: 1rpx; text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.9); }
.entry-divider { position: relative; z-index: 2; width: 70rpx; height: 1rpx; margin: 9rpx auto 2rpx; background: linear-gradient(90deg, transparent, rgba(221, 185, 115, 0.6), transparent); }
.entry-chevron { position: relative; z-index: 2; color: #cfa653; font-size: 20rpx; line-height: 1; }
.entry-ar .entry-chevron { color: #bc8de8; }
.entry-route .entry-chevron { color: #63cfc1; }
.entry-card:active { transform: translateY(3rpx) scale(0.98); filter: brightness(1.15); }

/* 战队羁绊 */
.kg-section { margin: 40rpx 27rpx 0; }
.section-heading { display: flex; align-items: center; justify-content: center; height: 78rpx; margin-bottom: 10rpx; overflow: hidden; }
.section-title-image { width: 400rpx; height: 126rpx; filter: drop-shadow(0 3rpx 7rpx rgba(0, 0, 0, 0.78)); }
.team-scroll { display: flex; width: 100%; height: 300rpx; white-space: nowrap; }
.team-card {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  flex-shrink: 0;
  width: 330rpx;
  height: 300rpx;
  margin-right: 22rpx;
  padding: 20rpx 14rpx 13rpx;
  overflow: hidden;
  vertical-align: top;
  text-align: center;
  border: 2rpx solid rgba(192, 143, 61, 0.65);
  border-radius: 8rpx 8rpx 17rpx 8rpx;
  box-sizing: border-box;
  box-shadow: inset 0 0 0 5rpx rgba(1, 6, 13, 0.72), 0 10rpx 25rpx rgba(0, 0, 0, 0.4);
}
.team-card:last-child { margin-right: 0; }
.team-card::before { content: ''; position: absolute; z-index: 4; inset: 7rpx; border: 1rpx solid rgba(234, 186, 93, 0.25); pointer-events: none; }
.team-card::after { content: ''; position: absolute; z-index: 1; inset: 0; background: linear-gradient(180deg, rgba(1, 5, 12, 0.04) 0%, rgba(1, 5, 12, 0.18) 42%, rgba(1, 5, 12, 0.86) 100%); pointer-events: none; }
.team-bg { position: absolute; z-index: 0; inset: 0; width: 100%; height: 100%; }
.team-edg { background: radial-gradient(circle at 50% 32%, rgba(119, 119, 119, 0.16), transparent 43%), linear-gradient(145deg, #171a20, #07090e); }
.team-ag { border-color: rgba(226, 55, 49, 0.75); background: radial-gradient(circle at 50% 32%, rgba(235, 31, 25, 0.27), transparent 45%), linear-gradient(145deg, #320506, #0e0305); }
.team-wolves { border-color: rgba(226, 175, 52, 0.75); background: radial-gradient(circle at 50% 30%, rgba(255, 202, 48, 0.25), transparent 46%), linear-gradient(145deg, #302507, #0c0902); }
.team-tes { border-color: rgba(226, 55, 49, 0.72); background: radial-gradient(circle at 50% 30%, rgba(222, 33, 40, 0.25), transparent 46%), linear-gradient(145deg, #29070b, #0b0305); }
.team-glow { position: absolute; z-index: 2; left: 15%; right: 15%; top: 25rpx; height: 100rpx; border-radius: 50%; background: rgba(255, 204, 93, 0.08); filter: blur(25rpx); }
.team-ag .team-glow { background: rgba(255, 43, 38, 0.18); }
.team-wolves .team-glow { background: rgba(255, 190, 35, 0.17); }
.team-tes .team-glow { background: rgba(255, 41, 34, 0.2); }
.team-logo { position: relative; z-index: 2; width: 142rpx; height: 142rpx; margin: -2rpx auto -5rpx; filter: drop-shadow(0 0 14rpx rgba(255, 195, 66, 0.19)); }
.team-logo-text { display: flex; align-items: center; justify-content: center; border: 3rpx solid rgba(255, 225, 155, 0.72); border-radius: 50%; color: #fff3cf; font-family: STKaiti, KaiTi, serif; font-size: 36rpx; font-weight: 900; box-sizing: border-box; box-shadow: inset 0 0 25rpx rgba(255, 255, 255, 0.12), 0 0 20rpx rgba(255, 190, 50, 0.22); }
.team-name { position: relative; z-index: 2; color: #f1d99c; font-family: STKaiti, KaiTi, serif; font-size: 30rpx; font-weight: 900; line-height: 1.1; text-shadow: 0 2rpx 5rpx #000; }
.team-bonds { position: relative; z-index: 2; margin-top: 6rpx; color: #e0c47e; font-size: 21rpx; white-space: nowrap; text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.9); }
.team-spirit { position: relative; z-index: 2; margin-top: 5rpx; color: #f0d58f; font-size: 23rpx; letter-spacing: 2rpx; text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.9); }
.team-diamond { position: absolute; z-index: 2; left: 50%; bottom: 5rpx; color: #e5b751; font-size: 12rpx; transform: translateX(-50%); }
.team-card:active { transform: translateY(3rpx) scale(0.98); filter: brightness(1.14); }

@keyframes starFloat {
  0%, 100% { transform: translateY(0); opacity: 0.36; }
  50% { transform: translateY(-12rpx); opacity: 0.9; }
}
