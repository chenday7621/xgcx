.container {
  min-height: 100vh;
  padding: 30rpx;
  position: relative;
  overflow: hidden;
}

/* 动态背景装饰 - 增强 */
.bg-decoration {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background:
    radial-gradient(ellipse at 30% 20%, rgba(230, 48, 40, 0.08) 0%, transparent 50%),
    radial-gradient(ellipse at 70% 80%, rgba(255, 215, 0, 0.06) 0%, transparent 50%),
    radial-gradient(ellipse at 50% 50%, rgba(0, 204, 255, 0.04) 0%, transparent 60%);
}

.bg-decoration::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
  background-size: 100rpx 100rpx;
  opacity: 0.5;
  animation: gridFloat 20s linear infinite;
}

@keyframes gridFloat {
  0% { transform: translate(0, 0); }
  100% { transform: translate(100rpx, 100rpx); }
}

.particle-container {
  position: absolute;
  inset: -20rpx;
}

.particle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.7;
  animation: floatParticle 10s ease-in-out infinite;
  box-shadow:
    0 0 8rpx currentColor,
    0 0 20rpx currentColor,
    0 0 32rpx currentColor;
  transition: all 0.3s ease;
}

.particle::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 200%;
  height: 200%;
  border-radius: 50%;
  background: radial-gradient(circle, currentColor 0%, transparent 70%);
  opacity: 0.3;
  animation: pulse 2s ease-in-out infinite;
}

/* 装饰性呼吸光环 */
.orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(60rpx);
}

.orb-1 {
  top: 10%;
  left: -10%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(230, 48, 40, 0.15) 0%, transparent 70%);
  animation: breathe 8s ease-in-out infinite;
}

.orb-2 {
  bottom: 20%;
  right: -15%;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(255, 215, 0, 0.12) 0%, transparent 70%);
  animation: breathe 10s ease-in-out infinite 2s;
}

.orb-3 {
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(0, 204, 255, 0.08) 0%, transparent 70%);
  animation: breathe 12s ease-in-out infinite 4s;
}

@keyframes breathe {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 0.4;
  }
  33% {
    transform: translate(-50%, -50%) scale(1.2);
    opacity: 0.6;
  }
  66% {
    transform: translate(-50%, -50%) scale(0.9);
    opacity: 0.3;
  }
}

@keyframes floatParticle {
  0%, 100% {
    transform: translateY(0) rotate(0deg) scale(1);
    opacity: 0.7;
  }
  25% {
    transform: translateY(-40rpx) rotate(90deg) scale(1.1);
    opacity: 0.9;
  }
  50% {
    transform: translateY(-30rpx) rotate(180deg) scale(1);
    opacity: 0.8;
  }
  75% {
    transform: translateY(-50rpx) rotate(270deg) scale(1.05);
    opacity: 0.9;
  }
}

/* 内容包装器 - 渐进式入场 */
.content-wrapper {
  position: relative;
  z-index: 1;
  opacity: 0;
  transform: translateY(60rpx);
  transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.content-wrapper.visible {
  opacity: 1;
  transform: translateY(0);
}

/* 元素渐进式入场动画 */
.animate-on-visible {
  opacity: 0;
  transform: translateY(40rpx);
  transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.content-wrapper.visible .animate-on-visible {
  opacity: 1;
  transform: translateY(0);
}

/* 延迟动画 - 每个元素依次出现 */
.delay-1 { transition-delay: 0.1s; }
.delay-2 { transition-delay: 0.2s; }
.delay-3 { transition-delay: 0.35s; }
.delay-4 { transition-delay: 0.5s; }
.delay-5 { transition-delay: 0.65s; }
.delay-6 { transition-delay: 0.8s; }
.delay-7 { transition-delay: 0.95s; }
.delay-8 { transition-delay: 1.1s; }
.delay-9 { transition-delay: 1.25s; }
.delay-10 { transition-delay: 1.4s; }

/* 标题装饰 */
.title-wrapper {
  position: relative;
  display: inline-block;
}

.title-decoration {
  position: absolute;
  bottom: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60%;
  height: 4rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--primary-gold) 20%,
    var(--primary-gold) 80%,
    transparent 100%
  );
  border-radius: 2rpx;
  box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.5);
  animation: shimmerLine 3s ease-in-out infinite;
}

@keyframes shimmerLine {
  0%, 100% {
    opacity: 0.6;
    transform: translateX(-50%) scaleX(0.8);
  }
  50% {
    opacity: 1;
    transform: translateX(-50%) scaleX(1);
  }
}

/* 头部区域 - 更炫酷 */
.header-section {
  padding-top: 80rpx;
  margin-bottom: 36rpx;
  position: relative;
  z-index: 1;
  text-align: center;
}

.title-glow {
  font-size: 64rpx;
  font-weight: 900;
  color: var(--primary-gold);
  text-shadow:
    0 0 40rpx rgba(255, 215, 0, 0.7),
    0 0 80rpx rgba(255, 215, 0, 0.5),
    0 4rpx 12rpx rgba(0, 0, 0, 0.6),
    0 0 0 4rpx rgba(255, 215, 0, 0.2);
  letter-spacing: 4rpx;
  animation:
    glow 2s ease-in-out infinite,
    titleFloat 4s ease-in-out infinite;
  position: relative;
  display: inline-block;
  background: linear-gradient(
    90deg,
    var(--primary-gold) 0%,
    var(--primary-gold-light) 50%,
    var(--primary-gold) 100%
  );
  background-size: 200% auto;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

@keyframes titleFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4rpx); }
}

.subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  text-shadow: 0 0 16rpx rgba(153, 153, 187, 0.3);
}

.subtitle-icon {
  font-size: 10rpx;
  color: var(--primary-gold);
  animation: twinkle 2s ease-in-out infinite;
}

@keyframes twinkle {
  0%, 100% { opacity: 0.4; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

/* 欢迎卡片 - 玻璃拟态增强 */
.welcome-card {
  position: relative;
  overflow: hidden;
  animation: fadeInUp 0.6s ease-out backwards;
  border: 2rpx solid rgba(255, 215, 0, 0.15);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.4),
    0 2rpx 8rpx rgba(230, 48, 40, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08),
    0 0 0 1rpx rgba(255, 215, 0, 0.1);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.welcome-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 100%;
  height: 100%;
  background:
    radial-gradient(circle, rgba(230, 48, 40, 0.12) 0%, transparent 60%),
    radial-gradient(circle at 80% 20%, rgba(255, 215, 0, 0.08) 0%, transparent 40%);
  border-radius: 50%;
  animation: pulse 4s ease-in-out infinite, rotate 30s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.welcome-card::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, transparent 50%),
    linear-gradient(45deg, rgba(255, 215, 0, 0.03) 0%, transparent 50%);
  pointer-events: none;
}

.welcome-card:active {
  transform: scale(0.99);
  box-shadow:
    0 6rpx 24rpx rgba(0, 0, 0, 0.35),
    0 1rpx 4rpx rgba(230, 48, 40, 0.15),
    inset 0 0 32rpx rgba(255, 215, 0, 0.08);
}

.welcome-header {
  display: flex;
  gap: 28rpx;
  position: relative;
  z-index: 1;
  align-items: center;
}

.emotion-emoji {
  font-size: 88rpx;
  animation: floatEmoji 3s ease-in-out infinite, glowPulse 2s ease-in-out infinite;
  filter: drop-shadow(0 10rpx 20rpx rgba(0, 0, 0, 0.4));
  position: relative;
  flex-shrink: 0;
}

.emotion-emoji::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 150%;
  height: 150%;
  background: radial-gradient(circle, rgba(255, 215, 0, 0.3) 0%, transparent 70%);
  filter: blur(12rpx);
  z-index: -1;
  animation: emojiGlow 2s ease-in-out infinite;
}

@keyframes floatEmoji {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }
  25% {
    transform: translateY(-12rpx) rotate(-5deg);
  }
  75% {
    transform: translateY(8rpx) rotate(5deg);
  }
}

@keyframes glowPulse {
  0%, 100% {
    filter: drop-shadow(0 10rpx 20rpx rgba(0, 0, 0, 0.4))
            drop-shadow(0 0 20rpx rgba(255, 215, 0, 0.3));
  }
  50% {
    filter: drop-shadow(0 12rpx 24rpx rgba(0, 0, 0, 0.5))
            drop-shadow(0 0 32rpx rgba(255, 215, 0, 0.5));
  }
}

@keyframes emojiGlow {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 0.5;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.3);
    opacity: 0.8;
  }
}

.welcome-content {
  flex: 1;
}

.welcome-title {
  font-size: 34rpx;
  color: var(--text-primary);
  font-weight: bold;
  margin-bottom: 8rpx;
}

.welcome-message {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.welcome-suggestions {
  margin-top: 28rpx;
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 12rpx;
}

.suggestion-tag {
  display: inline-block;
  padding: 14rpx 28rpx;
  border: 2rpx solid var(--primary-gold);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--primary-gold);
  background:
    linear-gradient(135deg, rgba(255, 215, 0, 0.12), rgba(255, 229, 92, 0.08));
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow:
    0 4rpx 16rpx rgba(255, 215, 0, 0.25),
    0 2rpx 4rpx rgba(0, 0, 0, 0.15),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
  position: relative;
  overflow: hidden;
  letter-spacing: 1rpx;
}

.suggestion-tag::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(
    circle at center,
    rgba(255, 215, 0, 0.3) 0%,
    transparent 70%
  );
  opacity: 0;
  transition: opacity 0.3s ease;
}

.suggestion-tag:active {
  transform: scale(0.95);
  background:
    linear-gradient(135deg, rgba(255, 215, 0, 0.25), rgba(255, 229, 92, 0.15));
  box-shadow:
    0 6rpx 24rpx rgba(255, 215, 0, 0.4),
    0 2rpx 6rpx rgba(0, 0, 0, 0.2),
    inset 0 0 24rpx rgba(255, 215, 0, 0.2);
  border-color: var(--primary-gold-light);
}

.suggestion-tag:active::before {
  opacity: 1;
  animation: ripple 0.6s ease-out;
}

@keyframes ripple {
  0% {
    transform: scale(0);
    opacity: 1;
  }
  100% {
    transform: scale(2);
    opacity: 0;
  }
}

/* 核心入口卡片 */
.core-entries {
  margin: 40rpx 0;
  position: relative;
  z-index: 1;
}

.entry-card {
  margin: 18rpx 0;
  position: relative;
  overflow: hidden;
  animation: fadeInUp 0.5s ease-out backwards;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
}

.entry-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08), transparent);
  transition: left 0.5s ease;
}

.entry-card:active::before {
  left: 100%;
}

.entry-icon {
  font-size: 64rpx;
  flex-shrink: 0;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.3));
  transition: transform 0.3s ease;
}

.entry-card:active .entry-icon {
  transform: scale(1.1) rotate(5deg);
}

.entry-content {
  flex: 1;
  min-width: 0;
}

.entry-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--primary-gold);
  position: relative;
  z-index: 1;
  letter-spacing: 1rpx;
  text-shadow: 0 0 16rpx rgba(255, 215, 0, 0.3);
}

.entry-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  position: relative;
  z-index: 1;
  line-height: 1.5;
  letter-spacing: 0.5rpx;
}

/* 战队卡片区域 */
.kg-section {
  margin-top: 40rpx;
  position: relative;
  z-index: 1;
}

.section-title {
  margin: 30rpx 0 20rpx;
  font-size: 36rpx;
  font-weight: 900;
  color: var(--primary-gold);
  display: flex;
  align-items: center;
  gap: 12rpx;
  text-shadow: 0 0 24rpx rgba(255, 215, 0, 0.5);
  letter-spacing: 2rpx;
}

.section-title-icon {
  font-size: 28rpx;
  animation: iconPulse 2s ease-in-out infinite;
  filter: drop-shadow(0 0 8rpx rgba(255, 215, 0, 0.6));
}

@keyframes iconPulse {
  0%, 100% { transform: scale(1); opacity: 0.9; }
  50% { transform: scale(1.15); opacity: 1; }
}

.section-title::before {
  content: '';
  width: 10rpx;
  height: 36rpx;
  background: linear-gradient(180deg, var(--primary-red), #ff5533, var(--primary-red));
  background-size: 100% 200%;
  border-radius: 6rpx;
  box-shadow:
    0 0 20rpx rgba(230, 48, 40, 0.8),
    0 0 40rpx rgba(230, 48, 40, 0.4);
  animation: glowPulse 2s ease-in-out infinite;
}

@keyframes glowPulse {
  0%, 100% {
    box-shadow:
      0 0 20rpx rgba(230, 48, 40, 0.8),
      0 0 40rpx rgba(230, 48, 40, 0.4);
  }
  50% {
    box-shadow:
      0 0 32rpx rgba(230, 48, 40, 1),
      0 0 60rpx rgba(230, 48, 40, 0.6);
  }
}

.team-scroll {
  white-space: nowrap;
  padding: 16rpx 4rpx;
}

.team-card {
  display: inline-block;
  width: 260rpx;
  margin-right: 28rpx;
  padding: 28rpx 24rpx;
  border: 2rpx solid rgba(42, 42, 74, 0.5);
  border-radius: 28rpx;
  background: linear-gradient(145deg, rgba(20, 20, 40, 0.9), rgba(28, 28, 56, 0.7));
  backdrop-filter: blur(16rpx);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  animation: fadeInUp 0.5s ease-out backwards;
  box-shadow:
    0 6rpx 24rpx rgba(0, 0, 0, 0.35),
    0 2rpx 8rpx rgba(0, 0, 0, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
  position: relative;
  overflow: hidden;
}

.team-card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 28rpx;
  padding: 2rpx;
  background: linear-gradient(
    135deg,
    rgba(255, 215, 0, 0.3) 0%,
    transparent 30%,
    transparent 70%,
    rgba(255, 215, 0, 0.3) 100%
  );
  -webkit-mask:
    linear-gradient(#fff 0 0) content-box,
    linear-gradient(#fff 0 0);
  mask:
    linear-gradient(#fff 0 0) content-box,
    linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  opacity: 0.6;
  transition: opacity 0.3s ease;
}

.team-card:nth-child(1) { animation-delay: 0.1s; }
.team-card:nth-child(2) { animation-delay: 0.2s; }
.team-card:nth-child(3) { animation-delay: 0.3s; }
.team-card:nth-child(4) { animation-delay: 0.4s; }

.team-card:active {
  transform: scale(0.94) translateY(4rpx);
  border-color: var(--primary-red);
  box-shadow:
    0 4rpx 16rpx rgba(230, 48, 40, 0.4),
    0 1rpx 4rpx rgba(0, 0, 0, 0.2),
    inset 0 0 32rpx rgba(255, 215, 0, 0.15);
}

.team-card:active::before {
  opacity: 1;
}

.team-logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  font-size: 48rpx;
  color: white;
  background: linear-gradient(135deg, var(--primary-red), #ff5533);
  box-shadow:
    0 12rpx 32rpx rgba(230, 48, 40, 0.5),
    0 4rpx 12rpx rgba(0, 0, 0, 0.3),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.3);
  border: 4rpx solid rgba(255, 215, 0, 0.4);
  position: relative;
  transition: all 0.3s ease;
}

.team-logo::before {
  content: '';
  position: absolute;
  inset: -8rpx;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(255, 215, 0, 0.3) 0%,
    transparent 70%
  );
  z-index: -1;
  animation: breathe 3s ease-in-out infinite;
  filter: blur(8rpx);
}

@keyframes breathe {
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.15); opacity: 0.9; }
}

.team-card:active .team-logo {
  transform: scale(0.92);
  box-shadow:
    0 8rpx 20rpx rgba(230, 48, 40, 0.6),
    0 2rpx 6rpx rgba(0, 0, 0, 0.4),
    inset 0 0 24rpx rgba(255, 215, 0, 0.3);
}

.team-name {
  text-align: center;
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
  text-shadow: 0 0 16rpx rgba(255, 255, 255, 0.2);
}

.team-bonds,
.team-spirit {
  font-size: 22rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 4rpx;
}
