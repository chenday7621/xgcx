/* 美食购买页面 - 电竞主题暗黑风格 */

page {
  background: linear-gradient(180deg, #0a0a1a 0%, #141428 100%);
}

.container {
  min-height: 100vh;
  padding: 30rpx;
  padding-bottom: 180rpx;
  position: relative;
}

/* 顶部装饰区 */
.header-decoration {
  width: 100%;
  height: 300rpx;
  background: linear-gradient(135deg, rgba(230, 48, 40, 0.2), rgba(255, 215, 0, 0.1));
  border-radius: 24rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  border: 2rpx solid rgba(230, 48, 40, 0.3);
}

.header-decoration::before {
  content: '🍔';
  font-size: 100rpx;
  animation: float 3s ease-in-out infinite;
}

.header-decoration::after {
  content: '';
  position: absolute;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255, 215, 0, 0.1) 0%, transparent 60%);
  animation: rotate 10s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 标题区 */
.title-section {
  margin-bottom: 30rpx;
  animation: fadeInUp 0.5s ease-out;
}

.page-title {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--primary-gold);
  text-shadow: 0 0 30rpx rgba(255, 215, 0, 0.5);
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding-left: 12rpx;
}

/* 分类标签 */
.category-tabs {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding: 10rpx 0 20rpx;
  margin-bottom: 20rpx;
}

.category-tab {
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  background: rgba(20, 20, 40, 0.6);
  border: 2rpx solid rgba(42, 42, 74, 0.6);
  color: var(--text-secondary);
  font-size: 26rpx;
  white-space: nowrap;
  transition: all 0.2s ease;
  backdrop-filter: blur(10rpx);
}

.category-tab.active {
  background: linear-gradient(135deg, var(--primary-red), #ff5533);
  color: white;
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(230, 48, 40, 0.4);
}

.category-tab:active {
  transform: scale(0.95);
}

/* 美食卡片网格 */
.food-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.food-card {
  background: linear-gradient(145deg, rgba(20, 20, 40, 0.85), rgba(28, 28, 56, 0.75));
  border: 2rpx solid rgba(42, 42, 74, 0.6);
  border-radius: 24rpx;
  padding: 20rpx;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  transition: all 0.2s ease;
  animation: fadeInUp 0.5s ease-out backwards;
  position: relative;
  overflow: hidden;
}

.food-card:nth-child(1) { animation-delay: 0.1s; }
.food-card:nth-child(2) { animation-delay: 0.15s; }
.food-card:nth-child(3) { animation-delay: 0.2s; }
.food-card:nth-child(4) { animation-delay: 0.25s; }
.food-card:nth-child(5) { animation-delay: 0.3s; }
.food-card:nth-child(6) { animation-delay: 0.35s; }

.food-card::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255, 215, 0, 0.1) 0%, transparent 50%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.food-card:active::before {
  opacity: 1;
}

.food-card:active {
  transform: scale(0.97) translateY(4rpx);
  border-color: var(--primary-gold);
  box-shadow: 0 4rpx 16rpx rgba(255, 215, 0, 0.3);
}

.food-image {
  width: 100%;
  height: 160rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  object-fit: cover;
  background: rgba(42, 42, 74, 0.5);
  border: 1rpx solid rgba(42, 42, 74, 0.3);
}

.food-name {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.food-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.food-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.food-price {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary-red);
  text-shadow: 0 0 16rpx rgba(230, 48, 40, 0.4);
}

.food-price::before {
  content: '¥';
  font-size: 22rpx;
  margin-right: 2rpx;
}

.food-sales {
  font-size: 20rpx;
  color: var(--text-muted);
}

.add-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-gold), #ffe55c);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--dark-bg);
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(255, 215, 0, 0.3);
  transition: all 0.2s ease;
  border: none;
  padding: 0;
  line-height: 56rpx;
}

.add-btn:active {
  transform: scale(0.9) rotate(90deg);
  box-shadow: 0 2rpx 8rpx rgba(255, 215, 0, 0.2);
}

/* 推荐横幅 */
.recommend-banner {
  margin: 30rpx 0;
  padding: 32rpx;
  background: linear-gradient(135deg, rgba(230, 48, 40, 0.2), rgba(255, 215, 0, 0.15));
  border: 2rpx solid rgba(230, 48, 40, 0.4);
  border-radius: 24rpx;
  backdrop-filter: blur(10rpx);
  animation: fadeInUp 0.6s ease-out;
  position: relative;
  overflow: hidden;
}

.recommend-banner::before {
  content: '🔥';
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  font-size: 60rpx;
  opacity: 0.3;
  animation: pulse 2s ease-in-out infinite;
}

.banner-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary-gold);
  margin-bottom: 8rpx;
}

.banner-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  color: var(--text-muted);
  animation: fadeIn 0.5s ease-out;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  text-align: center;
}

/* 底部购物车栏 */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 30rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(10, 10, 26, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(42, 42, 74, 0.5);
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.3);
  z-index: 100;
}

.cart-icon-wrapper {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--card-bg);
  border: 3rpx solid var(--card-border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-icon {
  font-size: 44rpx;
}

.cart-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  background: var(--primary-red);
  color: white;
  font-size: 20rpx;
  font-weight: bold;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--dark-bg);
  min-width: 32rpx;
  text-align: center;
}

.cart-info {
  flex: 1;
}

.cart-total {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary-gold);
}

.cart-total::before {
  content: '¥';
  font-size: 22rpx;
  margin-right: 2rpx;
}

.cart-delivery {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.checkout-btn {
  background: linear-gradient(135deg, var(--primary-gold), #ffe55c);
  color: var(--dark-bg);
  border-radius: 48rpx;
  padding: 28rpx 48rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 215, 0, 0.4);
  transition: all 0.2s ease;
}

.checkout-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(255, 215, 0, 0.3);
}

.checkout-btn:disabled {
  opacity: 0.4;
  transform: none;
  box-shadow: none;
}