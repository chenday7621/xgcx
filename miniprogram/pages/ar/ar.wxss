page {
  background: #010713;
}

.container {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #f7ecce;
  background:
    radial-gradient(circle at 18% 11%, rgba(24, 93, 176, 0.24), transparent 28%),
    radial-gradient(circle at 82% 35%, rgba(8, 74, 155, 0.2), transparent 26%),
    linear-gradient(180deg, #020817 0%, #031126 42%, #010711 100%);
}

.container::before,
.container::after,
.page-stars {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.container::before {
  opacity: 0.42;
  background-image:
    radial-gradient(circle, rgba(117, 195, 255, 0.85) 0 1rpx, transparent 2rpx),
    radial-gradient(circle, rgba(255, 213, 112, 0.65) 0 1rpx, transparent 2rpx);
  background-position: 21rpx 35rpx, 93rpx 126rpx;
  background-size: 156rpx 178rpx, 214rpx 236rpx;
}

.container::after {
  background:
    linear-gradient(120deg, transparent 46%, rgba(28, 103, 210, 0.12) 47%, transparent 50%) 0 220rpx / 100% 520rpx no-repeat,
    radial-gradient(ellipse at 50% 99%, rgba(0, 98, 255, 0.3), transparent 54%);
}

.page-stars {
  z-index: 0;
  background: linear-gradient(90deg, transparent, rgba(0, 128, 255, 0.06), transparent);
}

.custom-nav {
  position: relative;
  z-index: 10;
  box-sizing: border-box;
  height: 176rpx;
  padding-top: calc(env(safe-area-inset-top) + 20rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid rgba(91, 146, 218, 0.15);
  background: linear-gradient(180deg, rgba(1, 6, 18, 0.98), rgba(2, 11, 28, 0.78));
}

.nav-back {
  position: absolute;
  left: 28rpx;
  bottom: 24rpx;
  width: 64rpx;
  height: 64rpx;
  line-height: 56rpx;
  text-align: center;
  color: #efd27c;
  font-size: 66rpx;
  font-family: serif;
  text-shadow: 0 0 12rpx rgba(20, 128, 255, 0.9);
}

.nav-title {
  margin-top: 28rpx;
  color: #f5d986;
  font-family: STKaiti, KaiTi, serif;
  font-size: 43rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 0 #644414, 0 0 15rpx rgba(46, 148, 255, 0.9);
}

.page-content {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  padding: 28rpx 24rpx 78rpx;
}

.ar-frame-wrap {
  position: relative;
  width: 100%;
  height: 780rpx;
}

.ar-stage {
  position: absolute;
  z-index: 1;
  top: 34rpx;
  left: 28rpx;
  right: 28rpx;
  height: 558rpx;
  overflow: hidden;
  background: radial-gradient(circle at 50% 32%, rgba(17, 45, 85, 0.58), rgba(0, 2, 8, 0.98) 70%);
}

.scan-frame-image {
  position: absolute;
  z-index: 5;
  top: 0;
  left: 0;
  width: 100%;
  height: 610rpx;
  pointer-events: none;
}

.camera {
  width: 100%;
  height: 100%;
}

.camera-unauthorized {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  padding-bottom: 20rpx;
  background:
    linear-gradient(rgba(2, 8, 21, 0.7), rgba(1, 4, 12, 0.86)),
    repeating-linear-gradient(0deg, transparent 0 52rpx, rgba(55, 134, 226, 0.04) 53rpx 54rpx),
    repeating-linear-gradient(90deg, transparent 0 52rpx, rgba(55, 134, 226, 0.04) 53rpx 54rpx);
}

.auth-title {
  margin-bottom: 28rpx;
  color: #f7df99;
  font-family: STKaiti, KaiTi, serif;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-shadow: 0 0 12rpx rgba(41, 129, 255, 0.75);
}

.authorize-btn,
.scan-btn,
.action-btn {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  line-height: 1;
  background: transparent;
  overflow: visible;
}

.authorize-btn::after,
.scan-btn::after,
.action-btn::after {
  border: 0;
}

.authorize-btn {
  width: 360rpx;
  height: 118rpx;
}

.authorize-btn-image {
  display: block;
  width: 360rpx;
}

.authorize-btn:active,
.scan-btn:active,
.action-btn:active {
  opacity: 0.86;
  transform: scale(0.97);
}

.scan-status {
  position: absolute;
  z-index: 6;
  left: 20rpx;
  right: 20rpx;
  top: 628rpx;
  height: 144rpx;
}

.status-frame-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.status-content {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  height: 100%;
  padding: 25rpx 42rpx 18rpx;
}

.status-title {
  color: #f2d989;
  font-family: STKaiti, KaiTi, serif;
  font-size: 23rpx;
  font-weight: 700;
}

.status-hint {
  height: 36rpx;
  margin-top: 4rpx;
  overflow: hidden;
  color: #d7e8ff;
  font-size: 19rpx;
  line-height: 36rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.progress-wrap {
  width: 100%;
  height: 7rpx;
  margin-top: 2rpx;
  overflow: hidden;
  border: 1rpx solid rgba(62, 157, 255, 0.7);
  border-radius: 999rpx;
  background: rgba(1, 12, 30, 0.86);
  box-shadow: inset 0 0 8rpx rgba(0, 115, 255, 0.5);
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #078cff, #59e4ff, #f7d675);
  box-shadow: 0 0 10rpx #14baff;
}

.hero-projection {
  position: absolute;
  z-index: 3;
  transform: translate(-50%, -50%);
  width: 270rpx;
  padding: 18rpx;
  text-align: center;
  color: #fff;
  border: 1rpx solid rgba(92, 184, 255, 0.55);
  border-radius: 20rpx;
  background: linear-gradient(145deg, rgba(10, 39, 91, 0.9), rgba(15, 8, 59, 0.88));
  box-shadow: 0 0 30rpx rgba(24, 142, 255, 0.58);
}

.hero-model {
  width: 230rpx;
  height: 230rpx;
  margin: 0 auto;
}

.hero-model-status {
  margin-bottom: 8rpx;
  color: #ccefff;
  font-size: 20rpx;
}

.hero-model-status.error {
  color: #ffd4d4;
}

.hero-title {
  color: #f6dc8e;
  font-size: 34rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 8rpx;
  color: #9fdcff;
  font-size: 24rpx;
}

.hero-effect {
  margin-top: 8rpx;
  color: #e8f6ff;
  font-size: 22rpx;
}

.hero-shadow {
  width: 130rpx;
  height: 16rpx;
  margin: 10rpx auto 0;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.4);
}

.control-panel {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  margin-top: 18rpx;
}

.scan-btn-row {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  width: calc(100% + 48rpx);
  margin-left: -24rpx;
}

.scan-btn {
  position: relative;
  display: block;
  flex: none;
  width: 420rpx;
  height: 155rpx;
  margin: 0;
  transform: none;
}

.scan-btn:active {
  transform: scale(0.97);
}

.scan-btn-image {
  display: block;
  width: 420rpx;
}

.scan-btn-text {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 127rpx;
  line-height: 117rpx;
  color: #f6df9a;
  font-family: STKaiti, KaiTi, serif;
  font-size: 39rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-align: center;
  text-shadow: 0 2rpx 0 #4d3510, 0 0 10rpx rgba(84, 174, 255, 0.85);
}

/* 英雄选择模块保留原结构与原样式，不改动其选择功能。 */
.hero-picker-row {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(8, 10, 20, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-picker-label {
  color: var(--text-secondary);
  font-size: 24rpx;
}

.hero-picker-value {
  color: var(--text-primary);
  font-size: 26rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx 16rpx;
  margin-top: 24rpx;
}

.action-btn {
  width: 100%;
  min-width: 0;
}

.action-btn image {
  display: block;
  width: 100%;
}

.history {
  margin-top: 40rpx;
}

.history-title {
  margin-bottom: 16rpx;
  color: #f0d27a;
  font-family: STKaiti, KaiTi, serif;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  text-shadow: 0 0 12rpx rgba(37, 132, 255, 0.75);
}

.history-item {
  margin-bottom: 16rpx;
  padding: 24rpx 28rpx;
  color: #dceaff;
  border: 1rpx solid rgba(221, 176, 76, 0.66);
  border-radius: 12rpx;
  background: linear-gradient(135deg, rgba(5, 28, 65, 0.84), rgba(1, 10, 27, 0.9));
  box-shadow: inset 0 0 18rpx rgba(0, 97, 214, 0.26);
}
