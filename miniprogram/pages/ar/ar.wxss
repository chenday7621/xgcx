.container { min-height: 100vh; padding: 30rpx; background: #05050f; }
.hint { color: var(--text-secondary); font-size: 26rpx; margin-bottom: 20rpx; }
.scan-btn { background: linear-gradient(135deg, var(--primary-red), #ff5533); color: #fff; border-radius: 40rpx; }
.title { font-size: 34rpx; color: var(--primary-gold); font-weight: bold; }
.desc, .line { margin-top: 10rpx; color: var(--text-secondary); }
.btn-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.small-btn { flex: 1; background: var(--card-border); color: var(--text-primary); border-radius: 12rpx; }
.history { margin-top: 30rpx; }
.history-title { color: var(--primary-gold); margin-bottom: 10rpx; }
.history-item { padding: 16rpx; border: 1rpx solid var(--card-border); border-radius: 12rpx; margin-bottom: 10rpx; }
