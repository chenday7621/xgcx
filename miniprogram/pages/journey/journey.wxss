.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0d0d1a 0%, #1a1a2e 50%, #16213e 100%);
  padding: 0 24rpx 120rpx;
  position: relative;
  overflow-x: hidden;
}

.container::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background: radial-gradient(ellipse at 50% 0%, rgba(255, 215, 0, 0.15) 0%, transparent 70%);
  pointer-events: none;
}

.header {
  position: relative;
  padding: 60rpx 0 40rpx;
  text-align: center;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 600rpx;
  height: 200rpx;
  background: radial-gradient(ellipse, rgba(255, 215, 0, 0.2) 0%, transparent 70%);
  filter: blur(40rpx);
}

.header-content {
  position: relative;
  z-index: 1;
}

.header-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
  display: block;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.title {
  font-size: 48rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #ffd700 0%, #ff8c00 50%, #ffd700 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-shadow: 0 0 40rpx rgba(255, 215, 0, 0.3);
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(204, 214, 246, 0.7);
  letter-spacing: 8rpx;
}

.card {
  background: linear-gradient(135deg, rgba(30, 30, 50, 0.8) 0%, rgba(20, 20, 40, 0.9) 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 215, 0, 0.1);
  backdrop-filter: blur(20rpx);
  position: relative;
  overflow: hidden;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 215, 0, 0.3), transparent);
}

.card-hero {
  background: linear-gradient(135deg, rgba(40, 30, 60, 0.9) 0%, rgba(30, 20, 50, 0.95) 100%);
  border-color: rgba(147, 112, 219, 0.2);
}

.card-hero::before {
  background: linear-gradient(90deg, transparent, rgba(147, 112, 219, 0.4), transparent);
}

.card-secondary {
  background: linear-gradient(135deg, rgba(20, 40, 50, 0.9) 0%, rgba(15, 30, 40, 0.95) 100%);
  border-color: rgba(0, 212, 255, 0.1);
}

.card-secondary::before {
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.3), transparent);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.card-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #ccd6f6;
}

.team-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.team-card {
  background: rgba(255, 255, 255, 0.03);
  border-radius: 24rpx;
  padding: 28rpx 20rpx;
  text-align: center;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.team-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.1) 0%, transparent 50%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.team-card-selected {
  border-color: #ffd700;
  background: rgba(255, 215, 0, 0.1);
  box-shadow: 0 8rpx 32rpx rgba(255, 215, 0, 0.2);
  transform: scale(1.02);
}

.team-card-selected::after {
  opacity: 1;
}

.team-card:active {
  transform: scale(0.98);
}

.team-card-selected:active {
  transform: scale(1);
}

.team-avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.team-card-selected .team-avatar {
  background: linear-gradient(135deg, #ffd700 0%, #ff8c00 100%);
  box-shadow: 0 4rpx 20rpx rgba(255, 215, 0, 0.4);
}

.team-name {
  font-size: 28rpx;
  color: #ccd6f6;
  font-weight: 500;
}

.team-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #00d26a 0%, #00b894 100%);
  border-radius: 50%;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 210, 106, 0.4);
}

.city-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.city-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.02);
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  transition: all 0.3s ease;
}

.city-item-selected {
  border-color: #00d4ff;
  background: rgba(0, 212, 255, 0.08);
  box-shadow: 0 4rpx 20rpx rgba(0, 212, 255, 0.15);
}

.city-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.city-info {
  flex: 1;
}

.city-name {
  font-size: 30rpx;
  color: #ccd6f6;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.city-tag {
  font-size: 22rpx;
  color: rgba(136, 146, 176, 0.7);
}

.city-radio {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.city-item-selected .city-radio {
  border-color: #00d4ff;
  box-shadow: 0 0 16rpx rgba(0, 212, 255, 0.4);
}

.city-radio-inner {
  width: 24rpx;
  height: 24rpx;
  background: linear-gradient(135deg, #00d4ff 0%, #0099cc 100%);
  border-radius: 50%;
  animation: scaleIn 0.2s ease;
}

@keyframes scaleIn {
  from { transform: scale(0); }
  to { transform: scale(1); }
}

.gen-btn {
  width: 100%;
  padding: 32rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
  color: rgba(204, 214, 246, 0.5);
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 56rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  margin: 16rpx 0 24rpx;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.gen-btn-ready {
  background: linear-gradient(135deg, #ffd700 0%, #ff8c00 100%);
  color: #1a1a2e;
  border: none;
  box-shadow: 0 12rpx 40rpx rgba(255, 140, 0, 0.4);
}

.gen-btn::after {
  border: none;
}

.gen-btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.gen-btn-icon {
  font-size: 36rpx;
}

.gen-btn-text {
  letter-spacing: 4rpx;
}

.card-route {
  background: linear-gradient(135deg, rgba(50, 40, 30, 0.95) 0%, rgba(40, 30, 20, 0.98) 100%);
  border-color: rgba(255, 215, 0, 0.2);
}

.card-route::before {
  background: linear-gradient(90deg, transparent, rgba(255, 215, 0, 0.5), transparent);
}

.route-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.route-badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  background: linear-gradient(135deg, #ffd700 0%, #ff8c00 100%);
  color: #1a1a2e;
  font-size: 22rpx;
  font-weight: bold;
  border-radius: 30rpx;
  margin-bottom: 16rpx;
}

.route-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffd700;
  margin-bottom: 16rpx;
}

.route-meta {
  display: flex;
  justify-content: center;
  gap: 40rpx;
}

.route-meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: rgba(204, 214, 246, 0.7);
}

.route-meta-icon {
  font-size: 24rpx;
}

.timeline {
  padding-left: 20rpx;
}

.timeline-item {
  display: flex;
  margin-bottom: 8rpx;
}

.timeline-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
}

.timeline-dot {
  width: 32rpx;
  height: 32rpx;
  background: rgba(255, 215, 0, 0.2);
  border: 3rpx solid #ffd700;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.timeline-dot-inner {
  width: 12rpx;
  height: 12rpx;
  background: #ffd700;
  border-radius: 50%;
  box-shadow: 0 0 12rpx rgba(255, 215, 0, 0.6);
}

.timeline-line {
  width: 3rpx;
  flex: 1;
  background: linear-gradient(180deg, rgba(255, 215, 0, 0.4) 0%, rgba(255, 215, 0, 0.1) 100%);
  margin: 8rpx 0;
  min-height: 40rpx;
}

.timeline-content {
  flex: 1;
  padding-bottom: 24rpx;
}

.timeline-num {
  font-size: 20rpx;
  color: rgba(255, 215, 0, 0.6);
  margin-bottom: 8rpx;
  font-weight: 500;
}

.timeline-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  border-left: 4rpx solid #ffd700;
}

.timeline-name {
  font-size: 28rpx;
  color: #ccd6f6;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.timeline-desc {
  font-size: 22rpx;
  color: rgba(136, 146, 176, 0.8);
}

.ar-btn {
  width: 100%;
  padding: 28rpx;
  background: linear-gradient(135deg, #00d4ff 0%, #0099cc 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 56rpx;
  border: none;
  box-shadow: 0 12rpx 40rpx rgba(0, 212, 255, 0.3);
  margin-top: 32rpx;
}

.ar-btn::after {
  border: none;
}

.ar-btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.ar-btn-icon {
  font-size: 32rpx;
}

.ar-btn-text {
  letter-spacing: 2rpx;
}

.ar-btn-arrow {
  font-size: 32rpx;
  transition: transform 0.3s ease;
}

.ar-btn:active .ar-btn-arrow {
  transform: translateX(8rpx);
}

.card-history {
  background: linear-gradient(135deg, rgba(25, 25, 45, 0.9) 0%, rgba(20, 20, 35, 0.95) 100%);
}

.history-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.history-count {
  margin-left: auto;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.empty-state {
  text-align: center;
  padding: 40rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(204, 214, 246, 0.6);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: rgba(136, 146, 176, 0.5);
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.02);
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  transition: all 0.3s ease;
}

.history-item-active {
  border-color: #ffd700;
  background: rgba(255, 215, 0, 0.08);
}

.history-item-left {
  margin-right: 20rpx;
}

.history-item-badge {
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.2) 0%, rgba(255, 140, 0, 0.2) 100%);
  color: #ffd700;
  font-size: 22rpx;
  font-weight: bold;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.history-item-content {
  flex: 1;
}

.history-item-title {
  font-size: 28rpx;
  color: #ccd6f6;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.history-item-desc {
  font-size: 22rpx;
  color: rgba(136, 146, 176, 0.7);
}

.history-item-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
}

.history-item:active {
  transform: scale(0.98);
}

.history-item-active .history-item-arrow {
  color: #ffd700;
}

.footer-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  margin-top: 16rpx;
}

.footer-tip-icon {
  font-size: 28rpx;
}

.footer-tip-text {
  font-size: 24rpx;
  color: rgba(136, 146, 176, 0.6);
}
