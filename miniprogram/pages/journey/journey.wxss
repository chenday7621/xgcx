.container {
  position: relative;
  min-height: 100vh;
  padding-bottom: 35rpx;
  overflow-x: hidden;
  color: #f3d79b;
  background: #010712;
}

.page-background {
  position: fixed;
  z-index: 0;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.container::after {
  content: '';
  position: fixed;
  z-index: 1;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(0, 4, 13, 0.02), rgba(0, 5, 15, 0.12) 35%, rgba(0, 3, 10, 0.55));
}

.custom-nav {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: flex-end;
  height: 66rpx;
  padding: calc(env(safe-area-inset-top) + 4rpx + 40px) 26rpx 10rpx;
  box-sizing: content-box;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 62rpx;
  border: 1rpx solid rgba(204, 151, 72, 0.62);
  border-radius: 12rpx 12rpx 20rpx 12rpx;
  background: rgba(2, 13, 30, 0.72);
  box-shadow: inset 0 0 15rpx rgba(0, 92, 206, 0.18), 0 0 12rpx rgba(0, 0, 0, 0.5);
}

.nav-back image { width: 48rpx; height: 48rpx; }
.nav-back:active { filter: brightness(1.3); transform: scale(0.94); }
.capsule-safe-space { width: 184rpx; height: 64rpx; margin-left: auto; }

.hero-header {
  position: relative;
  z-index: 3;
  height: 320rpx;
  margin-top: -4rpx;
}

.hero-image {
  position: absolute;
  left: 50%;
  top: -7rpx;
  width: 420rpx;
  height: auto;
  filter: drop-shadow(0 0 18rpx rgba(0, 103, 255, 0.48));
  transform: translateX(-50%);
}

.route-shell {
  position: relative;
  z-index: 3;
  margin: -5rpx 24rpx 0;
  padding: 27rpx 27rpx 18rpx;
  border: 2rpx solid rgba(197, 145, 66, 0.72);
  border-radius: 9rpx 9rpx 24rpx 9rpx;
  background: linear-gradient(180deg, rgba(2, 17, 38, 0.88), rgba(1, 10, 25, 0.94));
  box-shadow: inset 0 0 0 5rpx rgba(0, 8, 20, 0.68), inset 0 0 42rpx rgba(0, 85, 184, 0.1), 0 14rpx 30rpx rgba(0, 0, 0, 0.42);
}

.route-shell::before {
  content: '';
  position: absolute;
  inset: 10rpx;
  border: 1rpx solid rgba(210, 158, 75, 0.22);
  pointer-events: none;
}

.shell-corner { position: absolute; z-index: 5; width: 25rpx; height: 25rpx; border-color: #e1ae56; border-style: solid; pointer-events: none; }
.shell-corner-tl { left: 5rpx; top: 5rpx; border-width: 3rpx 0 0 3rpx; }
.shell-corner-tr { right: 5rpx; top: 5rpx; border-width: 3rpx 3rpx 0 0; }
.shell-corner-bl { left: 5rpx; bottom: 5rpx; border-width: 0 0 3rpx 3rpx; }
.shell-corner-br { right: 5rpx; bottom: 5rpx; border-width: 0 3rpx 3rpx 0; }

.route-section { position: relative; z-index: 2; }
.section-heading { display: block; height: auto; filter: drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, 0.75)); }
.heading-teams { width: 355rpx; margin: 0 0 13rpx -7rpx; }
.heading-city { width: 355rpx; margin: 25rpx 0 10rpx -7rpx; }
.heading-history { width: 275rpx; margin: 4rpx 0 0 -3rpx; }

/* 战队卡片：保持与上一轮确认的样式一致 */
.team-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.team-card {
  position: relative;
  height: 282rpx;
  padding: 17rpx 12rpx 12rpx;
  overflow: hidden;
  text-align: center;
  border: 2rpx solid rgba(192, 143, 61, 0.65);
  border-radius: 8rpx 8rpx 17rpx 8rpx;
  box-sizing: border-box;
  box-shadow: inset 0 0 0 5rpx rgba(1, 6, 13, 0.72), 0 10rpx 25rpx rgba(0, 0, 0, 0.4);
  transition: transform 0.2s ease, filter 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.team-card::before {
  content: '';
  position: absolute;
  z-index: 4;
  inset: 7rpx;
  border: 1rpx solid rgba(234, 186, 93, 0.25);
  pointer-events: none;
}

.team-card::after {
  content: '';
  position: absolute;
  z-index: 1;
  inset: 0;
  background: linear-gradient(180deg, rgba(1, 5, 12, 0.03) 0%, rgba(1, 5, 12, 0.2) 43%, rgba(1, 5, 12, 0.9) 100%);
  pointer-events: none;
}

.team-bg { position: absolute; z-index: 0; inset: 0; width: 100%; height: 100%; }
.team-edg { background: linear-gradient(145deg, #171a20, #07090e); }
.team-ag { border-color: rgba(226, 55, 49, 0.75); background: linear-gradient(145deg, #320506, #0e0305); }
.team-wolves { border-color: rgba(226, 175, 52, 0.75); background: linear-gradient(145deg, #302507, #0c0902); }
.team-tes { border-color: rgba(226, 55, 49, 0.72); background: linear-gradient(145deg, #29070b, #0b0305); }

.team-glow { position: absolute; z-index: 2; left: 15%; right: 15%; top: 22rpx; height: 92rpx; border-radius: 50%; background: rgba(255, 204, 93, 0.08); filter: blur(25rpx); }
.team-ag .team-glow { background: rgba(255, 43, 38, 0.18); }
.team-wolves .team-glow { background: rgba(255, 190, 35, 0.17); }
.team-tes .team-glow { background: rgba(255, 41, 34, 0.2); }

.team-logo { position: relative; z-index: 2; width: 126rpx; height: 126rpx; margin: -2rpx auto -4rpx; filter: drop-shadow(0 0 14rpx rgba(255, 195, 66, 0.2)); }
.team-name { position: relative; z-index: 2; color: #f1d99c; font-family: STSong, "Songti SC", SimSun, serif; font-size: 28rpx; font-weight: 900; line-height: 1.1; text-shadow: 0 2rpx 5rpx #000; }
.team-bonds { position: relative; z-index: 2; margin-top: 5rpx; overflow: hidden; color: #e0c47e; font-size: 19rpx; line-height: 1.2; text-overflow: ellipsis; text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.9); white-space: nowrap; }
.team-spirit { position: relative; z-index: 2; margin-top: 5rpx; color: #f0d58f; font-family: STSong, "Songti SC", SimSun, serif; font-size: 21rpx; letter-spacing: 2rpx; text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.9); }
.team-diamond { position: absolute; z-index: 2; left: 50%; bottom: 4rpx; color: #e5b751; font-size: 11rpx; transform: translateX(-50%); }

.team-card-selected { border-color: #f2c76d; box-shadow: inset 0 0 0 5rpx rgba(1, 6, 13, 0.72), inset 0 0 28rpx rgba(30, 128, 255, 0.25), 0 0 24rpx rgba(245, 192, 79, 0.5); transform: scale(1.015); }
.team-card-selected::before { border-color: rgba(255, 220, 145, 0.8); box-shadow: inset 0 0 12rpx rgba(0, 124, 255, 0.35); }
.team-card:active { filter: brightness(1.14); transform: translateY(3rpx) scale(0.98); }
.team-card-selected:active { transform: translateY(2rpx) scale(1); }

.team-check {
  position: absolute;
  z-index: 5;
  top: 11rpx;
  right: 11rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  color: #07101e;
  font-size: 21rpx;
  font-weight: 900;
  border: 2rpx solid #ffe6a5;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffe49a, #ca8b2d);
  box-shadow: 0 0 14rpx rgba(255, 200, 84, 0.7), inset 0 0 7rpx rgba(255, 255, 255, 0.45);
  box-sizing: border-box;
}

.city-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 11rpx; }

.city-item {
  position: relative;
  height: 180rpx;
  overflow: hidden;
  border: 1rpx solid transparent;
  border-radius: 8rpx 8rpx 15rpx 8rpx;
  box-sizing: border-box;
  transition: transform 0.18s ease, filter 0.18s ease, box-shadow 0.18s ease;
}

.city-card-image { width: 100%; height: 100%; }
.city-item-selected { border-color: #f1bf57; box-shadow: 0 0 18rpx rgba(255, 190, 66, 0.45), inset 0 0 15rpx rgba(0, 112, 255, 0.32); filter: brightness(1.1); }
.city-item:active { transform: scale(0.97); filter: brightness(1.2); }

.city-selected-dot {
  position: absolute;
  right: 13rpx;
  top: 13rpx;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #ffe69d;
  border-radius: 50%;
  background: #1d7eff;
  box-shadow: 0 0 10rpx #0b78ff, inset 0 0 4rpx #fff;
}

.gen-btn {
  position: relative;
  z-index: 2;
  display: block;
  width: 120%;
  height: 230rpx;
  margin: 22rpx -10% 12rpx;
  padding: 0;
  overflow: visible;
  border: 0;
  border-radius: 0;
  color: transparent;
  background: transparent;
}

.gen-btn::after { border: 0; }
.gen-btn-image { position: absolute; left: 0; top: 0; width: 100%; height: auto; opacity: 0.66; transition: opacity 0.2s ease, filter 0.2s ease; }
.gen-btn-ready .gen-btn-image { opacity: 1; filter: drop-shadow(0 0 12rpx rgba(255, 168, 33, 0.42)); }
.gen-btn:active .gen-btn-image { transform: scale(0.98); filter: brightness(1.18); }
.gen-loading-text { position: absolute; z-index: 2; inset: 0; display: flex; align-items: center; justify-content: center; color: #2a1604; font-family: STSong, "Songti SC", SimSun, serif; font-size: 27rpx; font-weight: 900; }

.route-result {
  position: relative;
  z-index: 2;
  margin: 14rpx 0 25rpx;
  padding: 30rpx 28rpx 26rpx;
  border: 1rpx solid rgba(201, 148, 66, 0.72);
  border-radius: 8rpx 8rpx 18rpx 8rpx;
  background: linear-gradient(145deg, rgba(5, 25, 53, 0.95), rgba(2, 11, 28, 0.97));
  box-shadow: inset 0 0 24rpx rgba(0, 91, 201, 0.14);
}

.route-header { text-align: center; margin-bottom: 28rpx; }
.route-badge { display: inline-block; padding: 6rpx 22rpx; color: #07101e; font-size: 21rpx; font-weight: 800; border-radius: 22rpx; background: linear-gradient(135deg, #f6d26d, #bd7a20); }
.route-title { margin-top: 12rpx; color: #f0cf87; font-family: STSong, "Songti SC", SimSun, serif; font-size: 33rpx; font-weight: 900; text-shadow: 0 2rpx 5rpx #000; }
.route-meta { display: flex; justify-content: center; gap: 30rpx; margin-top: 12rpx; color: #9eb1cb; font-size: 21rpx; }

.timeline { padding-left: 8rpx; }
.timeline-item { display: flex; }
.timeline-left { display: flex; flex-direction: column; align-items: center; margin-right: 20rpx; }
.timeline-dot { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; border: 2rpx solid #d8a84f; border-radius: 50%; background: rgba(0, 87, 190, 0.28); }
.timeline-dot-inner { width: 10rpx; height: 10rpx; border-radius: 50%; background: #f2c561; box-shadow: 0 0 9rpx #157eff; }
.timeline-line { flex: 1; width: 2rpx; min-height: 42rpx; margin: 6rpx 0; background: linear-gradient(#d7a64d, rgba(14, 93, 180, 0.35)); }
.timeline-content { flex: 1; padding-bottom: 18rpx; }
.timeline-num { margin-bottom: 6rpx; color: #c99b4d; font-size: 19rpx; }
.timeline-card { padding: 16rpx 20rpx; border-left: 3rpx solid #d5a24a; background: rgba(4, 33, 69, 0.68); }
.timeline-name { color: #e9d5aa; font-size: 25rpx; font-weight: 700; }
.timeline-desc { margin-top: 5rpx; color: #8fa0b9; font-size: 20rpx; }

.ar-btn { width: 100%; margin-top: 18rpx; color: #191006; border: 1rpx solid #f4ce73; border-radius: 8rpx; background: linear-gradient(135deg, #e8b84f, #a86a1e); }
.ar-btn::after { border: 0; }
.ar-btn > view { display: inline-block; font-family: STSong, "Songti SC", SimSun, serif; font-size: 27rpx; font-weight: 900; }
.ar-btn-arrow { margin-left: 10rpx; }

.history-section { position: relative; z-index: 2; margin-top: 2rpx; }
.history-panel { position: relative; min-height: 250rpx; padding: 32rpx 30rpx 25rpx; box-sizing: border-box; }
.history-panel-frame { position: absolute; z-index: 0; inset: 0; width: 100%; height: 100%; pointer-events: none; }
.empty-state { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; height: 205rpx; }
.empty-state image { width: 380rpx; height: 265rpx; }

.history-list { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 12rpx; max-height: 430rpx; overflow-y: auto; }
.history-item { display: flex; align-items: center; padding: 17rpx 18rpx; border: 1rpx solid rgba(196, 145, 65, 0.32); border-radius: 7rpx; background: rgba(2, 24, 53, 0.72); }
.history-item-active { border-color: #e3b457; box-shadow: inset 0 0 13rpx rgba(0, 109, 236, 0.25); }
.history-item-badge { margin-right: 15rpx; padding: 7rpx 13rpx; color: #efcb7c; font-size: 19rpx; border: 1rpx solid rgba(216, 166, 78, 0.55); border-radius: 6rpx; }
.history-item-content { flex: 1; min-width: 0; }
.history-item-title { overflow: hidden; color: #e5d3ad; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.history-item-desc { margin-top: 4rpx; color: #8292ab; font-size: 19rpx; }
.history-item-arrow { color: #c69b50; font-size: 34rpx; }
.history-item:active { filter: brightness(1.2); transform: scale(0.99); }

.footer-tip { position: relative; z-index: 2; display: block; width: 575rpx; height: auto; margin: 2rpx auto -7rpx; opacity: 0.88; }
