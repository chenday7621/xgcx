<view class="container">
  <image class="page-background" src="/imgs/chat/background.png" mode="aspectFill"></image>

  <view class="chat-header">
    <view class="header-left" bindtap="goBack">
      <image class="back-image" src="/imgs/chat/back.png" mode="aspectFit"></image>
    </view>
    <view class="header-title">AI对话</view>
    <view class="capsule-safe-space"></view>
  </view>

  <view class="hero-section">
    <image class="hero-title-image" src="/imgs/chat/hero-title.png" mode="widthFix"></image>
  </view>

  <scroll-view class="chat-messages" scroll-y="{{true}}" scroll-into-view="{{scrollToView}}" scroll-with-animation="{{true}}">
    <view wx:if="{{messages.length === 0}}" class="welcome-panel">
      <image class="welcome-panel-frame" src="/imgs/chat/welcome-panel.png" mode="scaleToFill"></image>
      <view class="welcome-inner">
        <view class="welcome-top">
          <image class="welcome-avatar" src="/imgs/chat/robot.png" mode="aspectFit"></image>
          <view class="welcome-copy">
            <view class="welcome-text">你好！我是你的电竞AI助手</view>
            <view class="welcome-desc">我能：解读选手羁绊 · 传递赛事精神 · 规划文旅路线</view>
          </view>
        </view>
        <view class="quick-title">你可以问我：</view>
        <view class="quick-questions">
          <view wx:for="{{quickQuestions}}" wx:key="id" class="quick-tag" data-question="{{item.text}}" bindtap="onQuickQuestion">
            <image class="quick-tag-frame" src="/imgs/chat/quick-frame.png" mode="scaleToFill"></image>
            <text>{{item.text}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:for="{{messages}}" wx:key="id" id="msg-{{index}}" class="message-item {{item.role === 'user' ? 'user-message' : 'ai-message'}}">
      <view wx:if="{{item.role === 'ai'}}" class="message-content">
        <image class="avatar ai-avatar" src="/imgs/chat/robot.png" mode="aspectFit"></image>
        <view class="message-bubble ai-bubble {{item.isError ? 'error-bubble' : ''}}">
          <text class="message-text" user-select="{{true}}">{{item.content}}</text>
          <view wx:if="{{item.suggestions}}" class="suggestions">
            <view wx:for="{{item.suggestions}}" wx:for-item="suggestion" wx:key="index" class="suggestion-btn" data-suggestion="{{suggestion}}" bindtap="onSuggestionTap">{{suggestion}}</view>
          </view>
          <view class="message-time">{{item.time}}</view>
        </view>
      </view>
      <view wx:if="{{item.role !== 'ai'}}" class="message-content">
        <view class="message-bubble user-bubble">
          <text class="message-text">{{item.content}}</text>
          <view class="emotion-tag">{{item.emotionEmoji}}</view>
        </view>
        <view class="avatar user-avatar">召</view>
      </view>
    </view>

    <view wx:if="{{isTyping}}" class="typing-indicator">
      <image class="avatar ai-avatar" src="/imgs/chat/robot.png" mode="aspectFit"></image>
      <view class="typing-bubble"><view class="typing-dot"></view><view class="typing-dot"></view><view class="typing-dot"></view></view>
    </view>
    <view class="message-bottom-space"></view>
  </scroll-view>

  <view class="chat-input-area">
    <view class="input-wrapper">
      <image class="input-frame" src="/imgs/chat/input-frame.png" mode="scaleToFill"></image>
      <input class="chat-input" placeholder="问我任何电竞问题..." placeholder-class="input-placeholder" value="{{inputText}}" bindinput="onInputChange" bindconfirm="sendMessage" confirm-type="send" adjust-position="{{true}}" />
      <view class="send-btn {{inputText ? 'active' : ''}}" bindtap="sendMessage">
        <image src="/imgs/chat/send-button.png" mode="scaleToFill"></image>
      </view>
    </view>
    <view class="input-hint">支持：选手羁绊 · 赛事精神 · 文旅路线 · AR扫描</view>
  </view>
</view>
