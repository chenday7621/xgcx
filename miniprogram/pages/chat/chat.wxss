.container { height: 100vh; display: flex; flex-direction: column; background: var(--dark-bg); }
.chat-header { display: flex; align-items: center; justify-content: space-between; padding: 60rpx 30rpx 20rpx; border-bottom: 1rpx solid var(--card-border); }
.header-left, .header-right { width: 120rpx; }
.back-icon { font-size: 48rpx; color: var(--primary-gold); }
.header-right { text-align: right; font-size: 26rpx; color: var(--text-secondary); }
.header-center { flex: 1; display: flex; flex-direction: column; align-items: center; }
.ai-status { display: flex; align-items: center; gap: 12rpx; font-size: 32rpx; font-weight: bold; }
.status-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #66ff66; }
.emotion-badge { padding: 6rpx 20rpx; border-radius: 20rpx; font-size: 22rpx; color: var(--dark-bg); margin-top: 8rpx; }
.chat-messages { flex: 1; padding: 30rpx; }
.welcome-message { display: flex; margin-bottom: 40rpx; }
.welcome-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: linear-gradient(135deg, #ff4444, #ff8833); display: flex; align-items: center; justify-content: center; font-size: 40rpx; margin-right: 20rpx; }
.welcome-content { flex: 1; background: var(--card-bg); border: 1rpx solid var(--card-border); border-radius: 16rpx; padding: 24rpx; }
.welcome-text { font-size: 30rpx; color: var(--primary-gold); font-weight: bold; }
.welcome-desc { margin-top: 8rpx; color: var(--text-secondary); font-size: 24rpx; }
.quick-title { display: block; margin-top: 12rpx; color: var(--text-secondary); font-size: 24rpx; }
.quick-tag { display: inline-block; margin: 10rpx 10rpx 0 0; padding: 8rpx 14rpx; border: 1rpx solid var(--primary-gold); color: var(--primary-gold); border-radius: 20rpx; font-size: 22rpx; }
.message-item { margin-bottom: 28rpx; display: flex; }
.user-message { flex-direction: row-reverse; }
.message-content { display: flex; max-width: 80%; }
.user-message .message-content { flex-direction: row-reverse; }
.avatar { width: 64rpx; height: 64rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 16rpx; }
.ai-avatar { background: linear-gradient(135deg, #ff4444, #ff8833); }
.user-avatar { background: var(--card-border); }
.message-bubble { padding: 20rpx 24rpx; border-radius: 16rpx; }
.ai-bubble { background: var(--card-bg); border: 1rpx solid var(--card-border); }
.user-bubble { background: linear-gradient(135deg, var(--primary-red), #ff5533); display: flex; gap: 10rpx; }
.message-text { font-size: 28rpx; line-height: 1.6; word-break: break-word; }
.user-bubble .message-text { color: white; }
.emotion-tag { background: rgba(255,255,255,0.2); border-radius: 10rpx; padding: 4rpx 8rpx; }
.suggestions { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.suggestion-btn { padding: 8rpx 14rpx; border: 1rpx solid var(--primary-gold); color: var(--primary-gold); border-radius: 18rpx; font-size: 22rpx; }
.message-time { margin-top: 8rpx; font-size: 20rpx; color: var(--text-secondary); text-align: right; }
.typing-indicator { display: flex; align-items: center; margin-bottom: 20rpx; }
.typing-bubble { display: flex; gap: 8rpx; padding: 16rpx 20rpx; border: 1rpx solid var(--card-border); border-radius: 14rpx; background: var(--card-bg); }
.typing-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--primary-gold); }
.chat-input-area { padding: 20rpx 30rpx; border-top: 1rpx solid var(--card-border); background: var(--dark-bg); }
.input-wrapper { display: flex; align-items: center; gap: 14rpx; background: var(--card-bg); border: 2rpx solid var(--card-border); border-radius: 40rpx; padding: 12rpx 20rpx; }
.chat-input { flex: 1; font-size: 28rpx; color: var(--text-primary); }
.input-placeholder { color: var(--text-secondary); }
.send-btn { padding: 14rpx 30rpx; border-radius: 28rpx; background: var(--card-border); color: var(--text-secondary); }
.send-btn.active { background: linear-gradient(135deg, var(--primary-red), #ff5533); color: white; }
.input-hint { margin-top: 10rpx; text-align: center; color: var(--text-secondary); font-size: 22rpx; }
