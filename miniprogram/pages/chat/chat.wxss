.container { height: 100vh; display: flex; flex-direction: column; background: linear-gradient(180deg, var(--dark-bg-deep) 0%, var(--dark-bg) 100%); }

/* 聊天头部 - 玻璃拟态 */
.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 30rpx 24rpx;
  border-bottom: 1rpx solid rgba(42, 42, 74, 0.5);
  background: rgba(10, 10, 26, 0.6);
  backdrop-filter: blur(20rpx);
  position: relative;
  z-index: 10;
}

.header-left, .header-right {
  width: 120rpx;
  display: flex;
  align-items: center;
}

.header-left { justify-content: flex-start; }
.header-right { justify-content: flex-end; }

.back-icon {
  font-size: 48rpx;
  color: var(--primary-gold);
  text-shadow: 0 0 16rpx rgba(255, 215, 0, 0.5);
  transition: all 0.2s ease;
}

.back-icon:active {
  transform: scale(0.9);
  text-shadow: 0 0 24rpx rgba(255, 215, 0, 0.8);
}

.header-right {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.header-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.ai-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #66ff66;
  box-shadow: 0 0 12rpx rgba(102, 255, 102, 0.8);
  animation: pulse 2s ease-in-out infinite;
}

.emotion-badge {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  color: var(--dark-bg);
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  transition: all 0.2s ease;
}

.emotion-badge:active {
  transform: scale(0.95);
}

/* 聊天消息区域 */
.chat-messages {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
  position: relative;
  z-index: 1;
}

/* 欢迎消息 - 增强 */
.welcome-message {
  display: flex;
  margin-bottom: 40rpx;
  animation: fadeInUp 0.5s ease-out;
}

.welcome-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff4444, #ff8833, #ffcc00);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 68, 68, 0.4);
  border: 4rpx solid rgba(255, 215, 0, 0.3);
  animation: float 3s ease-in-out infinite;
}

.welcome-content {
  flex: 1;
  background: linear-gradient(135deg, rgba(20, 20, 40, 0.9), rgba(28, 28, 56, 0.8));
  border: 2rpx solid rgba(42, 42, 74, 0.6);
  border-radius: 20rpx;
  padding: 28rpx;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.welcome-text {
  font-size: 32rpx;
  color: var(--primary-gold);
  font-weight: bold;
  margin-bottom: 12rpx;
}

.welcome-desc {
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
}

.quick-title {
  display: block;
  margin-top: 16rpx;
  color: var(--text-muted);
  font-size: 24rpx;
}

.quick-tag {
  display: inline-block;
  margin: 12rpx 12rpx 0 0;
  padding: 12rpx 24rpx;
  border: 2rpx solid rgba(255, 215, 0, 0.5);
  border-radius: 28rpx;
  font-size: 24rpx;
  color: var(--primary-gold);
  background: rgba(255, 215, 0, 0.08);
  transition: all 0.2s ease;
  box-shadow: 0 2rpx 8rpx rgba(255, 215, 0, 0.1);
}

.quick-tag:active {
  transform: scale(0.95);
  background: rgba(255, 215, 0, 0.15);
  box-shadow: 0 4rpx 16rpx rgba(255, 215, 0, 0.25);
}

/* 消息项 */
.message-item {
  margin-bottom: 32rpx;
  display: flex;
  opacity: 0;
  animation: fadeInUp 0.4s ease-out forwards;
}

.user-message {
  flex-direction: row-reverse;
}

.message-content {
  display: flex;
  max-width: 82%;
  gap: 16rpx;
}

.user-message .message-content {
  flex-direction: row-reverse;
}

/* 头像 */
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 12rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.ai-avatar {
  background: linear-gradient(135deg, #ff4444, #ff8833, #ffcc00);
  border: 3rpx solid rgba(255, 215, 0, 0.4);
  font-size: 36rpx;
}

.user-avatar {
  background: linear-gradient(135deg, var(--card-bg), var(--card-border));
  border: 2rpx solid var(--card-border);
  font-size: 32rpx;
}

/* 消息气泡 */
.message-bubble {
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  position: relative;
  transition: all 0.2s ease;
  max-width: 100%;
}

.ai-bubble {
  background: linear-gradient(135deg, rgba(20, 20, 40, 0.95), rgba(28, 28, 56, 0.9));
  border: 2rpx solid rgba(42, 42, 74, 0.6);
  border-radius: 20rpx 20rpx 20rpx 4rpx;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2),
              0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.ai-bubble:active {
  transform: scale(0.98);
}

.user-bubble {
  background: linear-gradient(135deg, var(--primary-red), #ff5533, #ff7755);
  border-radius: 20rpx 20rpx 4rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(230, 48, 40, 0.4),
              0 1rpx 0 rgba(255, 255, 255, 0.1);
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.user-bubble:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(230, 48, 40, 0.3);
}

.message-text {
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-word;
  color: var(--text-primary);
}

.user-bubble .message-text {
  color: white;
  flex: 1;
}

.emotion-tag {
  background: rgba(255, 255, 255, 0.25);
  border-radius: 12rpx;
  padding: 6rpx 10rpx;
  font-size: 22rpx;
  flex-shrink: 0;
  backdrop-filter: blur(10rpx);
}

/* 建议按钮 */
.suggestions {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.suggestion-btn {
  padding: 12rpx 24rpx;
  border: 2rpx solid rgba(255, 215, 0, 0.5);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--primary-gold);
  background: rgba(255, 215, 0, 0.1);
  transition: all 0.2s ease;
  box-shadow: 0 2rpx 8rpx rgba(255, 215, 0, 0.15);
}

.suggestion-btn:active {
  transform: scale(0.95);
  background: rgba(255, 215, 0, 0.2);
  box-shadow: 0 4rpx 16rpx rgba(255, 215, 0, 0.25);
}

.message-time {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--text-muted);
  text-align: right;
  opacity: 0.7;
}

/* 输入中指示器 */
.typing-indicator {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  animation: fadeIn 0.3s ease-out;
}

.typing-bubble {
  display: flex;
  gap: 10rpx;
  padding: 20rpx 28rpx;
  border: 2rpx solid rgba(42, 42, 74, 0.6);
  border-radius: 20rpx;
  background: rgba(20, 20, 40, 0.9);
  backdrop-filter: blur(10rpx);
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary-gold);
  animation: typingPulse 1.4s ease-in-out infinite;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingPulse {
  0%, 60%, 100% {
    transform: scale(1);
    opacity: 0.5;
  }
  30% {
    transform: scale(1.3);
    opacity: 1;
  }
}

/* 输入区域 */
.chat-input-area {
  padding: 24rpx 30rpx 40rpx;
  border-top: 1rpx solid rgba(42, 42, 74, 0.5);
  background: rgba(10, 10, 26, 0.8);
  backdrop-filter: blur(20rpx);
  position: relative;
  z-index: 10;
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(20, 20, 40, 0.8);
  border: 2rpx solid rgba(42, 42, 74, 0.6);
  border-radius: 48rpx;
  padding: 16rpx 28rpx;
  backdrop-filter: blur(10rpx);
  transition: all 0.2s ease;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.input-wrapper:focus-within {
  border-color: var(--primary-gold);
  box-shadow: 0 0 24rpx rgba(255, 215, 0, 0.3);
}

.chat-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  height: 40rpx;
  line-height: 40rpx;
}

.input-placeholder {
  color: var(--text-muted);
}

.send-btn {
  padding: 14rpx 36rpx;
  border-radius: 32rpx;
  background: rgba(42, 42, 74, 0.6);
  color: var(--text-secondary);
  font-size: 26rpx;
  font-weight: bold;
  transition: all 0.2s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(42, 42, 74, 0.5);
}

.send-btn.active {
  background: linear-gradient(135deg, var(--primary-red), #ff5533);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(230, 48, 40, 0.4);
  border-color: transparent;
}

.send-btn:active {
  transform: scale(0.95);
}

.input-hint {
  margin-top: 12rpx;
  text-align: center;
  color: var(--text-muted);
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
}
